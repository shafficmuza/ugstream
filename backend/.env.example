# --- Database ---
DATABASE_URL="postgresql://ugstream_user:changeme@localhost:5432/ugstream_db"

# --- App ---
PORT=4001
CORS_ORIGINS="http://localhost:3000,https://ham.sentepos.com"
PAYMENTS_REDIRECT_URL="https://ham.sentepos.com/payments/callback"
# "/api" in production (Apache proxies /api/ to this backend on one shared
# domain); "" for local dev (backend hit directly, no proxy prefix).
PUBLIC_ASSET_PREFIX="/api"

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="changeme-generate-a-long-random-secret"
# TEMPORARY bypass while no SMS provider is wired up: every phone number
# gets this fixed OTP instead of a random one. Real account-takeover risk —
# set to "" the moment a real SMS provider is in place (sms.service.ts).
OTP_STATIC_CODE="1234"

# --- Cloudflare Stream (dashboard: dash.cloudflare.com -> Stream) ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_CUSTOMER_CODE=""
# Stream > Webhooks -> Add. Shown once at creation.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# --- Flutterwave (dashboard.flutterwave.com -> Settings -> API) ---
FLUTTERWAVE_SECRET_KEY=""
# Settings -> Webhooks -> set a "secret hash", paste same value here
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# --- Stripe (dashboard.stripe.com -> Developers -> API keys / Webhooks) ---
STRIPE_SECRET_KEY=""
# Add endpoint -> https://ham.sentepos.com/api/v1/webhooks/stripe -> signing secret
STRIPE_WEBHOOK_SECRET=""
# Card charges go through Stripe in USD, not UGX (see stripe.service.ts for
# why) — update as rates drift, this is a static config value.
STRIPE_UGX_PER_USD=3800

# --- MTN MoMo Collections (momodeveloper.mtn.com) ---
# "sandbox" or "production" — sandbox uses EUR test amounts, production UGX.
MOMO_ENV="sandbox"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
