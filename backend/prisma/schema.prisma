generator client {
  provider      = "prisma-client-js"
  // node:20-alpine ships OpenSSL 3.x with no libssl.so.1.1 compat package,
  // which the default musl engine binary needs — pin the openssl-3.0
  // variant explicitly rather than relying on Prisma's runtime detection.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  // Singleton row — always id=1. Enforced in the service layer (upsert on
  // a fixed id), not via a DB constraint, since Prisma has no clean way to
  // express "at most one row" beyond that.
  id                Int      @id @default(1)
  appName           String   @default("ugstream")
  logoUrl           String?
  tagline           String?
  supportEmail      String?  @map("support_email")
  supportPhone      String?  @map("support_phone")
  // Swappable background art — admin-uploaded, no redeploy needed to
  // change the "feel" of the site. Separate fields since the login page
  // is a small centered form (wants a moodier, less busy image) while the
  // homepage hero is wide — same image works for both if that's all an
  // admin wants to manage, but doesn't have to be.
  heroBackgroundUrl String?  @map("hero_background_url")
  authBackgroundUrl String?  @map("auth_background_url")
  // Which mobile-money processor is active for mobile-money checkouts:
  // 'momo' (MTN direct) | 'flutterwave' | 'yo' | 'dpo'. Card always goes to
  // Stripe. Admin flips this in the UI; the actual API credentials live in
  // env, never the DB.
  mobileMoneyProvider String @default("momo") @map("mobile_money_provider") @db.VarChar(20)
  // SMS/OTP routing: 'auto' | 'africastalking' | 'twilio'. Under 'auto' each
  // number is routed by country code — East African numbers to Africa's
  // Talking at ~$0.01, everything else to Twilio, which is under a cent for
  // US/UK numbers but ~$0.30 to Uganda. The forced modes exist for outages.
  // Credentials live in the secrets store; admin flips this in the UI.
  smsProvider       String   @default("auto") @map("sms_provider") @db.VarChar(20)
  // Per-number OTP limits. Admin-tunable because the right numbers depend on
  // what a message costs, and because an SMS-pumping attack is something you
  // need to be able to clamp down on at 2am without shipping a deploy.
  //
  // These are per phone number and complement the per-IP throttle on the
  // endpoint, which alone stops nothing distributed: 3/min/IP is ~$54/hour of
  // Twilio traffic from a single address and unbounded across a botnet.
  //
  // 0 means unlimited on each, handled explicitly by the enforcing code.
  otpCooldownSeconds Int     @default(60) @map("otp_cooldown_seconds")
  otpPerHour         Int     @default(3) @map("otp_per_hour")
  otpPerDay          Int     @default(10) @map("otp_per_day")
  // Push notifications. `pushEnabled` is the master switch so a noisy release
  // can be silenced without a deploy. `pushAudience` is 'all' | 'subscribers':
  // new-title alerts default to everyone because they are the main lever for
  // converting signed-up-but-not-paying users, but that is a business call an
  // admin may want to reverse.
  pushEnabled       Boolean  @default(true) @map("push_enabled")
  pushAudience      String   @default("all") @map("push_audience") @db.VarChar(20)
  // Account-sharing limits, both admin-tunable because the right number is a
  // commercial decision that changes with pricing, not an engineering one.
  //
  // maxSessions caps how many devices may stay signed in; a new sign-in past
  // the cap evicts the least recently used session rather than being refused,
  // so a user replacing a phone is never locked out of their own account.
  //
  // maxStreams caps how many may play at once. Deliberately separate: a
  // household legitimately keeps several devices signed in while only ever
  // watching on one or two, and conflating the two would either permit
  // wholesale password sharing or punish normal use.
  maxSessions       Int      @default(3) @map("max_sessions")
  maxStreams        Int      @default(2) @map("max_streams")
  // Development sign-in bypass: a fixed code that stands in for the SMS one on
  // a named handful of numbers, so the team can sign in while building without
  // paying for or waiting on a message.
  //
  // Off unless deliberately switched on, and scoped to devBypassPhones rather
  // than to a role — "every admin" is a set that grows by accident, and this
  // code is worth every account it opens.
  //
  // devBypassFailures exists because these codes are short by design. Four
  // digits is 10,000 guesses, which at the endpoint's throttle is under a
  // minute of scripted traffic; the counter disables the bypass long before a
  // search gets anywhere. It resets on every successful use, so ordinary
  // typing never walks it up to the limit.
  devBypassEnabled  Boolean  @default(false) @map("dev_bypass_enabled")
  devBypassCodeHash String?  @map("dev_bypass_code_hash")
  devBypassPhones   String[] @default([]) @map("dev_bypass_phones")
  devBypassFailures Int      @default(0) @map("dev_bypass_failures")
  devBypassSetAt    DateTime? @map("dev_bypass_set_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Audit trail of content actions — who uploaded/created what, when. Powers
// the admin "Activity" (daily uploads) view. `userId` is the acting staff
// member; `summary` is a human-readable line; `titleId` links to the title.
model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  action    String   @db.VarChar(40)
  titleId   BigInt?  @map("title_id")
  summary   String   @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

// Admin-editable secret values (payment API credentials, etc.), overriding
// the corresponding env var. Read via SecretsService (DB → env fallback).
// Values are never returned to the client — only a "configured" flag.
model Secret {
  key       String   @id @db.VarChar(60)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("secrets")
}

enum DevicePlatform {
  android
  ios
  web
}

// One row per app install that can receive push. The FCM registration token
// is the identity, not the user: tokens rotate, survive logout, and a shared
// phone can carry several accounts over time. `userId` is therefore nullable
// and re-pointed on each register call, so a token always belongs to whoever
// last signed in on that device — which is who should see the notification.
model Device {
  id         BigInt         @id @default(autoincrement())
  token      String         @unique
  platform   DevicePlatform
  userId     BigInt?        @map("user_id")
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appVersion String?        @map("app_version") @db.VarChar(20)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@map("devices")
}

// Send history. Kept so admins can see what went out, resend a announcement,
// and so the app can later show an in-app inbox without a second source of
// truth. Counts are recorded per send rather than derived, because FCM only
// reports per-token success at the moment of sending.
model Notification {
  id          BigInt   @id @default(autoincrement())
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(400)
  titleId     BigInt?  @map("title_id")
  titleRef    Title?   @relation(fields: [titleId], references: [id], onDelete: SetNull)
  audience    String   @default("all") @db.VarChar(20)
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notifications")
}

enum UserRole {
  user
  editor
  admin
}

enum UserStatus {
  active
  banned
}

model User {
  id           BigInt    @id @default(autoincrement())
  // E.164, normalised on every auth path (see auth/phone.util.ts). 15 digits
  // is the E.164 maximum, so the '+' needs a 16th character — the old
  // VarChar(15) would have rejected the longest legitimate international
  // numbers outright.
  phone        String    @unique @db.VarChar(20)
  displayName  String?   @map("display_name") @db.VarChar(100)
  email        String?   @db.VarChar(120)
  address      String?   @db.VarChar(200)
  role         UserRole  @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")
  // Optional sign-in PIN, set by the user after their first verified sign-in.
  // Once set, returning sign-ins cost nothing: no SMS is sent at all. The OTP
  // path stays available as the way back in when the PIN is forgotten or
  // locked, so a PIN is a shortcut, never the only key to the account.
  //
  // A four-digit PIN is only ten thousand guesses, so pinFailures/pinLockedUntil
  // are not optional extras — they are what makes this safe to offer at all.
  // Both reset on a correct PIN, so ordinary fumbling never accumulates.
  pinHash        String?   @map("pin_hash")
  pinSetAt       DateTime? @map("pin_set_at")
  pinFailures    Int       @default(0) @map("pin_failures")
  pinLockedUntil DateTime? @map("pin_locked_until")

  sessions      Session[]
  payments      Payment[]
  subscriptions Subscription[]
  purchases     Purchase[]
  watchHistory  WatchHistory[]
  myList        MyListItem[]
  devices       Device[]
  streamLeases  StreamLease[]

  @@map("users")
}

model OtpCode {
  id         BigInt    @id @default(autoincrement())
  // E.164, so wide enough for the longest international number plus '+'.
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash")
  // Send time, which is what the per-number rate limits count. Previously
  // inferred from expiresAt; that worked only while every code had the same
  // TTL and silently skewed every window by it.
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0) @db.SmallInt
  // Set when an admin issued this code by hand for a user who cannot receive
  // SMS. Such codes send no message and cost nothing, so they are excluded
  // from the per-number rate limits — those exist to cap spend, and counting
  // a free code against them would leave the user unable to reach the screen
  // where the code is entered. Also the audit trail: who issued it.
  issuedByAdminId BigInt? @map("issued_by_admin_id")

  @@index([phone, expiresAt])
  @@index([phone, createdAt])
  @@map("otp_codes")
}

// A break-glass sign-in code that opens any ordinary account, for use when the
// SMS gateway is failing and per-account recovery codes cannot be issued fast
// enough.
//
// This is deliberately a *bounded* backdoor, not the unlimited static code it
// replaces. Every field below exists to cap the blast radius if the code
// leaks, because a code that opens any account is exactly what an attacker
// most wants:
//
//   - expiresAt   it dies on its own; an admin cannot forget to turn it off
//   - revokedAt   and can kill it instantly before then
//   - failures    wrong guesses disable it, so it cannot be brute forced
//                 across the user base (~500k tries would otherwise be all
//                 that stands between an attacker and every account)
//   - uses        how many accounts it has opened, visible in the admin UI
//
// Only one is ever active: issuing revokes its predecessor. Privileged
// accounts are excluded in the verify path, so a leak cannot escalate to the
// admin panel — see AuthService.verifyOtp.
model MasterCode {
  id              BigInt    @id @default(autoincrement())
  codeHash        String    @map("code_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  issuedByAdminId BigInt    @map("issued_by_admin_id")
  uses            Int       @default(0)
  failures        Int       @default(0)

  @@index([revokedAt, expiresAt])
  @@map("master_codes")
}

// A claim on one of the account's concurrent-stream slots.
//
// Held per *session*, not per playback: re-opening the player on the same
// device reuses its lease rather than consuming a second slot, and one device
// can therefore never occupy two. Kept alive by the progress heartbeat the
// players already send every 15s; a lease with no recent heartbeat is treated
// as gone, so a crashed app, a closed laptop lid or a dead battery frees the
// slot on its own instead of stranding it until some manual cleanup.
model StreamLease {
  id         String    @id @default(uuid())
  userId     BigInt    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The auth session (JWT `sid`) holding the slot.
  sessionId  String    @map("session_id")
  episodeId  BigInt    @map("episode_id")
  deviceLabel String?  @map("device_label") @db.VarChar(100)
  startedAt  DateTime  @default(now()) @map("started_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  // Set when playback is stopped cleanly, so the slot frees immediately
  // rather than after the staleness window.
  endedAt    DateTime? @map("ended_at")

  // One live lease per auth session — the upsert key.
  @@unique([sessionId])
  @@index([userId, lastSeenAt])
  @@map("stream_leases")
}

// A session lasts until the user logs out or it is evicted by the device cap.
// Nothing expires it on a timer: being asked to sign in again halfway through
// a film is the single most user-hostile thing an app of this kind can do.
model Session {
  id           String    @id @default(uuid())
  userId       BigInt    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Public half of the refresh token (`lookup.verifier`), stored in the clear
  // so refresh is a single indexed read. Without it, verifying a token means
  // bcrypt-comparing against every live session in the system — which grows
  // linearly with users, and a refresh that takes seconds is itself a source
  // of the races this table now guards against. Nullable only for sessions
  // issued before this existed; those still verify by scan.
  refreshLookup String?  @unique @map("refresh_lookup")
  refreshHash  String    @map("refresh_hash")
  // The previous refresh token stays valid for a grace period after rotation.
  // A phone suspended by iOS between "server rotated" and "client persisted"
  // otherwise holds a token the server has already discarded, and the session
  // is dead through no fault of the user. Rotation is retained for its actual
  // purpose — a token replayed after the grace window is treated as theft.
  prevRefreshHash String? @map("prev_refresh_hash")
  prevRefreshAt   DateTime? @map("prev_refresh_at")
  deviceLabel  String?   @map("device_label") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

// NOTE: `kind` on Title is a plain String (not an enum) so admins can add
// their own kinds at runtime via the managed `Kind` table below — see
// KindsController. Existing values ('movie', 'series') are preserved.
model Kind {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kinds")
}

enum TitleAccess {
  free
  subscription
  purchase
  sub_or_purchase
}

model Title {
  id           BigInt       @id @default(autoincrement())
  kind         String       @default("movie") @db.VarChar(60)
  name         String       @db.VarChar(200)
  slug         String       @unique @db.VarChar(220)
  description  String?
  language     String?      @db.VarChar(30)
  vjName       String?      @map("vj_name") @db.VarChar(100)
  releaseYear  Int?         @map("release_year") @db.SmallInt
  posterUrl    String?      @map("poster_url")
  bannerUrl    String?      @map("banner_url")
  access       TitleAccess  @default(subscription)
  priceUgx     Int?         @map("price_ugx")
  rentalHours  Int          @default(72) @map("rental_hours")
  published    Boolean      @default(false)
  // When the "new title" push went out. Publishing is a toggle an admin may
  // flip several times while fixing artwork or episodes, so this is what
  // stops every flip from re-notifying the whole user base. A deliberate
  // re-announcement goes through the admin resend action instead.
  notifiedAt   DateTime?    @map("notified_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  episodes      Episode[]
  genres        TitleGenre[]
  purchases     Purchase[]
  myListItems   MyListItem[]
  notifications Notification[]

  @@index([published, kind, language])
  @@map("titles")
}

enum StreamStatus {
  pending
  uploading
  ready
  error
}

model Episode {
  id            BigInt       @id @default(autoincrement())
  titleId       BigInt       @map("title_id")
  title         Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season        Int          @default(1) @db.SmallInt
  number        Int          @default(1) @db.SmallInt
  name          String?      @db.VarChar(200)
  // Where this episode's video lives / is delivered from. 'cloudflare' =
  // Cloudflare Stream (max 1080p); 'r2_hls' = self-transcoded 4K HLS ladder
  // on Cloudflare R2. `cfStatus`/`durationSecs`/`thumbnailUrl` are reused as
  // the generic ready-state regardless of provider.
  videoProvider String       @default("cloudflare") @map("video_provider") @db.VarChar(20)
  cfVideoUid    String?      @unique @map("cf_video_uid") @db.VarChar(64)
  // R2 key prefix holding this episode's HLS output, e.g. "hls/ep-123/".
  // master.m3u8 lives at `${r2Prefix}master.m3u8`.
  r2Prefix      String?      @map("r2_prefix") @db.VarChar(120)
  cfStatus      StreamStatus @default(pending) @map("cf_status")
  durationSecs  Int?         @map("duration_secs")
  thumbnailUrl  String?      @map("thumbnail_url")

  watchHistory  WatchHistory[]

  @@unique([titleId, season, number])
  @@map("episodes")
}

model Genre {
  id     Int          @id @default(autoincrement())
  name   String       @unique @db.VarChar(50)
  slug   String       @unique @db.VarChar(60)
  titles TitleGenre[]

  @@map("genres")
}

model TitleGenre {
  titleId BigInt @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genreId Int    @map("genre_id")
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@map("title_genres")
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  priceUgx     Int      @map("price_ugx")
  durationDays Int      @map("duration_days") @db.SmallInt
  active       Boolean  @default(true)

  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

enum PaymentPurpose {
  subscription
  title
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

model Payment {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  user          User           @relation(fields: [userId], references: [id])
  amountUgx     Int            @map("amount_ugx")
  purpose       PaymentPurpose
  planId        Int?           @map("plan_id")
  plan          Plan?          @relation(fields: [planId], references: [id])
  titleId       BigInt?        @map("title_id")
  provider      String         @default("flutterwave") @db.VarChar(20)
  providerRef   String?        @unique @map("provider_ref") @db.VarChar(100)
  providerTxId  String?        @map("provider_txid") @db.VarChar(100)
  status        PaymentStatus  @default(pending)
  createdAt     DateTime       @default(now()) @map("created_at")
  confirmedAt   DateTime?      @map("confirmed_at")

  subscriptions Subscription[]
  purchases     Purchase[]

  @@index([userId, status])
  @@map("payments")
}

model Subscription {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  planId    Int      @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt(sort: Desc)])
  @@map("subscriptions")
}

model Purchase {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  titleId   BigInt   @map("title_id")
  title     Title    @relation(fields: [titleId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  expiresAt DateTime @map("expires_at")

  @@index([userId, titleId, expiresAt(sort: Desc)])
  @@map("purchases")
}

model MyListItem {
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   BigInt   @map("title_id")
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, titleId])
  @@map("my_list_items")
}

model WatchHistory {
  userId       BigInt   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId    BigInt   @map("episode_id")
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSecs Int      @default(0) @map("position_secs")
  completed    Boolean  @default(false)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, episodeId])
  @@map("watch_history")
}
