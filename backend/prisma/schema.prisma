generator client {
  provider      = "prisma-client-js"
  // node:20-alpine ships OpenSSL 3.x with no libssl.so.1.1 compat package,
  // which the default musl engine binary needs — pin the openssl-3.0
  // variant explicitly rather than relying on Prisma's runtime detection.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  // Singleton row — always id=1. Enforced in the service layer (upsert on
  // a fixed id), not via a DB constraint, since Prisma has no clean way to
  // express "at most one row" beyond that.
  id           Int      @id @default(1)
  appName      String   @default("ugstream")
  logoUrl      String?
  tagline      String?
  supportEmail String?  @map("support_email")
  supportPhone String?  @map("support_phone")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  banned
}

model User {
  id           BigInt    @id @default(autoincrement())
  phone        String    @unique @db.VarChar(15)
  displayName  String?   @map("display_name") @db.VarChar(100)
  role         UserRole  @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions      Session[]
  payments      Payment[]
  subscriptions Subscription[]
  purchases     Purchase[]
  watchHistory  WatchHistory[]

  @@map("users")
}

model OtpCode {
  id         BigInt    @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0) @db.SmallInt

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

model Session {
  id           String    @id @default(uuid())
  userId       BigInt    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String    @map("refresh_hash")
  deviceLabel  String?   @map("device_label") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

enum TitleKind {
  movie
  series
}

enum TitleAccess {
  free
  subscription
  purchase
  sub_or_purchase
}

model Title {
  id           BigInt       @id @default(autoincrement())
  kind         TitleKind
  name         String       @db.VarChar(200)
  slug         String       @unique @db.VarChar(220)
  description  String?
  language     String?      @db.VarChar(30)
  vjName       String?      @map("vj_name") @db.VarChar(100)
  releaseYear  Int?         @map("release_year") @db.SmallInt
  posterUrl    String?      @map("poster_url")
  bannerUrl    String?      @map("banner_url")
  access       TitleAccess  @default(subscription)
  priceUgx     Int?         @map("price_ugx")
  rentalHours  Int          @default(72) @map("rental_hours")
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")

  episodes    Episode[]
  genres      TitleGenre[]
  purchases   Purchase[]

  @@index([published, kind, language])
  @@map("titles")
}

enum StreamStatus {
  pending
  uploading
  ready
  error
}

model Episode {
  id            BigInt       @id @default(autoincrement())
  titleId       BigInt       @map("title_id")
  title         Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season        Int          @default(1) @db.SmallInt
  number        Int          @default(1) @db.SmallInt
  name          String?      @db.VarChar(200)
  cfVideoUid    String?      @unique @map("cf_video_uid") @db.VarChar(64)
  cfStatus      StreamStatus @default(pending) @map("cf_status")
  durationSecs  Int?         @map("duration_secs")
  thumbnailUrl  String?      @map("thumbnail_url")

  watchHistory  WatchHistory[]

  @@unique([titleId, season, number])
  @@map("episodes")
}

model Genre {
  id     Int          @id @default(autoincrement())
  name   String       @unique @db.VarChar(50)
  slug   String       @unique @db.VarChar(60)
  titles TitleGenre[]

  @@map("genres")
}

model TitleGenre {
  titleId BigInt @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genreId Int    @map("genre_id")
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@map("title_genres")
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  priceUgx     Int      @map("price_ugx")
  durationDays Int      @map("duration_days") @db.SmallInt
  active       Boolean  @default(true)

  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

enum PaymentPurpose {
  subscription
  title
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

model Payment {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  user          User           @relation(fields: [userId], references: [id])
  amountUgx     Int            @map("amount_ugx")
  purpose       PaymentPurpose
  planId        Int?           @map("plan_id")
  plan          Plan?          @relation(fields: [planId], references: [id])
  titleId       BigInt?        @map("title_id")
  provider      String         @default("flutterwave") @db.VarChar(20)
  providerRef   String?        @unique @map("provider_ref") @db.VarChar(100)
  providerTxId  String?        @map("provider_txid") @db.VarChar(100)
  status        PaymentStatus  @default(pending)
  createdAt     DateTime       @default(now()) @map("created_at")
  confirmedAt   DateTime?      @map("confirmed_at")

  subscriptions Subscription[]
  purchases     Purchase[]

  @@index([userId, status])
  @@map("payments")
}

model Subscription {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  planId    Int      @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt(sort: Desc)])
  @@map("subscriptions")
}

model Purchase {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  titleId   BigInt   @map("title_id")
  title     Title    @relation(fields: [titleId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  expiresAt DateTime @map("expires_at")

  @@index([userId, titleId, expiresAt(sort: Desc)])
  @@map("purchases")
}

model WatchHistory {
  userId       BigInt   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId    BigInt   @map("episode_id")
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSecs Int      @default(0) @map("position_secs")
  completed    Boolean  @default(false)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, episodeId])
  @@map("watch_history")
}
