generator client {
  provider      = "prisma-client-js"
  // node:20-alpine ships OpenSSL 3.x with no libssl.so.1.1 compat package,
  // which the default musl engine binary needs — pin the openssl-3.0
  // variant explicitly rather than relying on Prisma's runtime detection.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  // Singleton row — always id=1. Enforced in the service layer (upsert on
  // a fixed id), not via a DB constraint, since Prisma has no clean way to
  // express "at most one row" beyond that.
  id                Int      @id @default(1)
  appName           String   @default("ugstream")
  logoUrl           String?
  tagline           String?
  supportEmail      String?  @map("support_email")
  supportPhone      String?  @map("support_phone")
  // Swappable background art — admin-uploaded, no redeploy needed to
  // change the "feel" of the site. Separate fields since the login page
  // is a small centered form (wants a moodier, less busy image) while the
  // homepage hero is wide — same image works for both if that's all an
  // admin wants to manage, but doesn't have to be.
  heroBackgroundUrl String?  @map("hero_background_url")
  authBackgroundUrl String?  @map("auth_background_url")
  // Which mobile-money processor is active for mobile-money checkouts:
  // 'momo' (MTN direct) | 'flutterwave' | 'yo' | 'dpo'. Card always goes to
  // Stripe. Admin flips this in the UI; the actual API credentials live in
  // env, never the DB.
  mobileMoneyProvider String @default("momo") @map("mobile_money_provider") @db.VarChar(20)
  // Active SMS/OTP gateway: 'africastalking' | 'twilio'. Credentials live in
  // the secrets store; admin flips this in the UI.
  smsProvider       String   @default("africastalking") @map("sms_provider") @db.VarChar(20)
  // Push notifications. `pushEnabled` is the master switch so a noisy release
  // can be silenced without a deploy. `pushAudience` is 'all' | 'subscribers':
  // new-title alerts default to everyone because they are the main lever for
  // converting signed-up-but-not-paying users, but that is a business call an
  // admin may want to reverse.
  pushEnabled       Boolean  @default(true) @map("push_enabled")
  pushAudience      String   @default("all") @map("push_audience") @db.VarChar(20)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Audit trail of content actions — who uploaded/created what, when. Powers
// the admin "Activity" (daily uploads) view. `userId` is the acting staff
// member; `summary` is a human-readable line; `titleId` links to the title.
model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  action    String   @db.VarChar(40)
  titleId   BigInt?  @map("title_id")
  summary   String   @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

// Admin-editable secret values (payment API credentials, etc.), overriding
// the corresponding env var. Read via SecretsService (DB → env fallback).
// Values are never returned to the client — only a "configured" flag.
model Secret {
  key       String   @id @db.VarChar(60)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("secrets")
}

enum DevicePlatform {
  android
  ios
  web
}

// One row per app install that can receive push. The FCM registration token
// is the identity, not the user: tokens rotate, survive logout, and a shared
// phone can carry several accounts over time. `userId` is therefore nullable
// and re-pointed on each register call, so a token always belongs to whoever
// last signed in on that device — which is who should see the notification.
model Device {
  id         BigInt         @id @default(autoincrement())
  token      String         @unique
  platform   DevicePlatform
  userId     BigInt?        @map("user_id")
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appVersion String?        @map("app_version") @db.VarChar(20)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@map("devices")
}

// Send history. Kept so admins can see what went out, resend a announcement,
// and so the app can later show an in-app inbox without a second source of
// truth. Counts are recorded per send rather than derived, because FCM only
// reports per-token success at the moment of sending.
model Notification {
  id          BigInt   @id @default(autoincrement())
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(400)
  titleId     BigInt?  @map("title_id")
  titleRef    Title?   @relation(fields: [titleId], references: [id], onDelete: SetNull)
  audience    String   @default("all") @db.VarChar(20)
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notifications")
}

enum UserRole {
  user
  editor
  admin
}

enum UserStatus {
  active
  banned
}

model User {
  id           BigInt    @id @default(autoincrement())
  phone        String    @unique @db.VarChar(15)
  displayName  String?   @map("display_name") @db.VarChar(100)
  email        String?   @db.VarChar(120)
  address      String?   @db.VarChar(200)
  role         UserRole  @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions      Session[]
  payments      Payment[]
  subscriptions Subscription[]
  purchases     Purchase[]
  watchHistory  WatchHistory[]
  myList        MyListItem[]
  devices       Device[]

  @@map("users")
}

model OtpCode {
  id         BigInt    @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0) @db.SmallInt

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

model Session {
  id           String    @id @default(uuid())
  userId       BigInt    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String    @map("refresh_hash")
  deviceLabel  String?   @map("device_label") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

// NOTE: `kind` on Title is a plain String (not an enum) so admins can add
// their own kinds at runtime via the managed `Kind` table below — see
// KindsController. Existing values ('movie', 'series') are preserved.
model Kind {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kinds")
}

enum TitleAccess {
  free
  subscription
  purchase
  sub_or_purchase
}

model Title {
  id           BigInt       @id @default(autoincrement())
  kind         String       @default("movie") @db.VarChar(60)
  name         String       @db.VarChar(200)
  slug         String       @unique @db.VarChar(220)
  description  String?
  language     String?      @db.VarChar(30)
  vjName       String?      @map("vj_name") @db.VarChar(100)
  releaseYear  Int?         @map("release_year") @db.SmallInt
  posterUrl    String?      @map("poster_url")
  bannerUrl    String?      @map("banner_url")
  access       TitleAccess  @default(subscription)
  priceUgx     Int?         @map("price_ugx")
  rentalHours  Int          @default(72) @map("rental_hours")
  published    Boolean      @default(false)
  // When the "new title" push went out. Publishing is a toggle an admin may
  // flip several times while fixing artwork or episodes, so this is what
  // stops every flip from re-notifying the whole user base. A deliberate
  // re-announcement goes through the admin resend action instead.
  notifiedAt   DateTime?    @map("notified_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  episodes      Episode[]
  genres        TitleGenre[]
  purchases     Purchase[]
  myListItems   MyListItem[]
  notifications Notification[]

  @@index([published, kind, language])
  @@map("titles")
}

enum StreamStatus {
  pending
  uploading
  ready
  error
}

model Episode {
  id            BigInt       @id @default(autoincrement())
  titleId       BigInt       @map("title_id")
  title         Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season        Int          @default(1) @db.SmallInt
  number        Int          @default(1) @db.SmallInt
  name          String?      @db.VarChar(200)
  // Where this episode's video lives / is delivered from. 'cloudflare' =
  // Cloudflare Stream (max 1080p); 'r2_hls' = self-transcoded 4K HLS ladder
  // on Cloudflare R2. `cfStatus`/`durationSecs`/`thumbnailUrl` are reused as
  // the generic ready-state regardless of provider.
  videoProvider String       @default("cloudflare") @map("video_provider") @db.VarChar(20)
  cfVideoUid    String?      @unique @map("cf_video_uid") @db.VarChar(64)
  // R2 key prefix holding this episode's HLS output, e.g. "hls/ep-123/".
  // master.m3u8 lives at `${r2Prefix}master.m3u8`.
  r2Prefix      String?      @map("r2_prefix") @db.VarChar(120)
  cfStatus      StreamStatus @default(pending) @map("cf_status")
  durationSecs  Int?         @map("duration_secs")
  thumbnailUrl  String?      @map("thumbnail_url")

  watchHistory  WatchHistory[]

  @@unique([titleId, season, number])
  @@map("episodes")
}

model Genre {
  id     Int          @id @default(autoincrement())
  name   String       @unique @db.VarChar(50)
  slug   String       @unique @db.VarChar(60)
  titles TitleGenre[]

  @@map("genres")
}

model TitleGenre {
  titleId BigInt @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genreId Int    @map("genre_id")
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@map("title_genres")
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  priceUgx     Int      @map("price_ugx")
  durationDays Int      @map("duration_days") @db.SmallInt
  active       Boolean  @default(true)

  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

enum PaymentPurpose {
  subscription
  title
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

model Payment {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  user          User           @relation(fields: [userId], references: [id])
  amountUgx     Int            @map("amount_ugx")
  purpose       PaymentPurpose
  planId        Int?           @map("plan_id")
  plan          Plan?          @relation(fields: [planId], references: [id])
  titleId       BigInt?        @map("title_id")
  provider      String         @default("flutterwave") @db.VarChar(20)
  providerRef   String?        @unique @map("provider_ref") @db.VarChar(100)
  providerTxId  String?        @map("provider_txid") @db.VarChar(100)
  status        PaymentStatus  @default(pending)
  createdAt     DateTime       @default(now()) @map("created_at")
  confirmedAt   DateTime?      @map("confirmed_at")

  subscriptions Subscription[]
  purchases     Purchase[]

  @@index([userId, status])
  @@map("payments")
}

model Subscription {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  planId    Int      @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt(sort: Desc)])
  @@map("subscriptions")
}

model Purchase {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  titleId   BigInt   @map("title_id")
  title     Title    @relation(fields: [titleId], references: [id])
  paymentId BigInt   @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id])
  expiresAt DateTime @map("expires_at")

  @@index([userId, titleId, expiresAt(sort: Desc)])
  @@map("purchases")
}

model MyListItem {
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   BigInt   @map("title_id")
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, titleId])
  @@map("my_list_items")
}

model WatchHistory {
  userId       BigInt   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId    BigInt   @map("episode_id")
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSecs Int      @default(0) @map("position_secs")
  completed    Boolean  @default(false)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, episodeId])
  @@map("watch_history")
}
