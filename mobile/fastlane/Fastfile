# TestFlight release lane. Run from mobile/ (CI does this).
#
# Signing strategy: fastlane match with the certs stored on an orphan branch
# ("ios-certs") of this same private repo — no separate certs repo needed.
# Auth to App Store Connect is via API key (ASC_* env), never an Apple ID
# password.

default_platform(:ios)

platform :ios do
  desc "Build a signed IPA and upload to TestFlight"
  lane :beta do
    # Also sets the global Spaceship token, which `produce` relies on (that
    # action takes no api_key parameter).
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      set_spaceship_token: true,
    )

    setup_ci # ephemeral keychain for the runner

    # NOTE: app creation is a ONE-TIME MANUAL step. fastlane's `produce`
    # requires an Apple ID username (which forces interactive 2FA in CI), so
    # instead create the app once in App Store Connect:
    #   Bundle ID: com.prosystemsug.muzawatch   Name: Muza Watch   Platform: iOS
    # After that, match + pilot below run fully unattended on the API key.

    # Certificates + provisioning, persisted on the ios-certs branch.
    match(
      type: "appstore",
      app_identifier: "com.prosystemsug.muzawatch",
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "ios-certs",
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      readonly: false,
      # A capability added to the App ID (Push Notifications) does not appear
      # in an already-issued profile, and match only checks a profile's
      # validity and expiry — never its entitlements — so it would happily
      # reuse the stale one and signing would fail on aps-environment.
      # Forcing a reissue is what picks the new capability up.
      # Safe to set back to false once a signed build has succeeded.
      force: true,
    )

    # flutter create emits a project with no DEVELOPMENT_TEAM and automatic
    # signing, which xcodebuild rejects in CI. Point it at the team and the
    # profile match just provisioned.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: "com.prosystemsug.muzawatch",
      profile_name: "match AppStore com.prosystemsug.muzawatch",
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"],
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build/ipa",
      export_team_id: ENV.fetch("APPLE_TEAM_ID"),
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Manual",
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end

# Google Play release lane, the Android counterpart to `ios beta`.
#
# Auth is a Google Cloud service account JSON (PLAY_SERVICE_ACCOUNT_JSON),
# granted "Release to testing tracks" in Play Console → Users and permissions.
#
# ONE-TIME MANUAL STEPS before this lane can run:
#   1. Create the app in Play Console with package com.prosystemsug.muzawatch.
#   2. Upload one AAB by hand. The Play Developer API refuses to publish to an
#      app that has never had a release, so the first one cannot be automated.
#   3. Enable Play App Signing. Our keystore is then the *upload* key; Google
#      re-signs with the app signing key it holds.
platform :android do
  desc "Build a signed AAB and upload to the Play internal testing track"
  lane :internal do
    # Draft, not live: the build lands in Play Console for review, and a human
    # promotes it to production. Same shape as a TestFlight build waiting for
    # release — nothing reaches users without an explicit action.
    upload_to_play_store(
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      package_name: "com.prosystemsug.muzawatch",
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
